{
  "_comment": "骨架模板占位符 → 数据源映射表 v3.0。src=字段路径（profile./project./result./degradation. 前缀）；derived=由 fill_pptx.py 计算；manual=需人工判定，填充时若未提供会被 G5 抓出。",
  "_rule": "禁止在此表或脚本中写死任何产品数值。所有取值必须可追溯到三件套或引擎输出。",

  "P_MW": { "src": "project.requirement.powerMW.value", "fmt": "{:.0f}" },
